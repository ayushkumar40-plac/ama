# Copy to .env and fill from Firebase Console → Project Settings → Web app config
# FREE (Spark) services only: Auth + Firestore + Realtime Database.
# Cloud Storage is NOT used — new projects require a paid Blaze bucket for it,
# and this app only stores SHA-256 hashes + metadata (never raw files).
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Realtime Database URL — cloud: https://YOUR_PROJECT-default-rtdb.firebaseio.com
# (region Asia: https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app)
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com
# Local emulator dev (no keys needed, needs Java): true/false
VITE_USE_EMULATORS=true
# GitHub Pages sub-path base (ama repo). Vercel: set to /
VITE_BASE=/ama/
